# Copy this file to .env.deepline and fill in the values on your machine.
# The deepline CLI reads .env.deepline from the folder you run it in.
# Never commit .env.deepline or .env. This file lists names only.
#
# In GitHub, DEEPLINE_API_KEY goes in Settings > Secrets and variables > Actions.

DEEPLINE_API_KEY=
DEEPLINE_HOST_URL=https://code.deepline.com
